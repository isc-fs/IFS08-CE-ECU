/*
 * 0x701  PitDiag_pedals -- raw ADC counts for the two APPS channels and the
 * brake. Mirrors PitDiag_BuildPedals(). 100 ms while enabled.
 */

CAN_MSG(PitDiag_pedals, 0x701, 6, "VCU", 100)
    FIELD_BE (apps1_raw, uint16_t, 0, 16, 1, 0, "adc")
    FIELD_BE (apps2_raw, uint16_t, 2, 16, 1, 0, "adc")
    FIELD_BE (brake_raw, uint16_t, 4, 16, 1, 0, "adc")
CAN_MSG_END(PitDiag_pedals)
