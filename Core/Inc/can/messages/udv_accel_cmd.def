/*
 * 0x507  UDV_accel_cmd -- RX from uDV (#17). The autonomous acceleration
 * command: a raw IEEE-754 float32, little-endian (uDV STM32 side). The DSL
 * struct carries the RAW 32-bit pattern (raw-wire-integer convention,
 * can_codecs.hpp); the app layer bit-casts to float and conditions it
 * (clamp / NaN-reject / map to torque %) before the inverter path.
 * Units/scale/sign semantics PENDING from the DV team. Only consumed while
 * the DV drive mode is latched; stale stream => torque 0 (never APPS).
 */

CAN_MSG(UDV_accel_cmd, 0x507, 4, "uDV", 20)
    FIELD_LE (accel_cmd_raw, uint32_t, 0, 32, 1, 0, "f32le")
CAN_MSG_END(UDV_accel_cmd)
