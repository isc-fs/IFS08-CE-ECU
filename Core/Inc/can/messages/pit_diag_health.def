/*
 * 0x704  PitDiag_health -- firmware-health telemetry, parity with the AMS
 * 0x4A2/0x4A3 diag. Emitted from DiagTask (NOT ControlTask) so it survives a
 * ControlTask stall -- the exact failure mode it exists to diagnose (an IWDG
 * reset when ControlTask stops kicking the watchdog). Gated by 0x7E0 like the
 * rest of the stream.
 *
 * task_ran_mask: bit set = that task's step counter advanced since the
 * previous health frame. Bit map (mirrors EcuTaskId):
 *   b0 CONTROL  b1 CAN_RX  b2 CAN_TX  b3 DIAG
 * reset_cause: 0 unknown, 1 POR, 2 PIN, 3 SOFT, 4 IWDG, 5 WWDG, 6 LPWR/BOR.
 * last_fault: sticky sentinel latched in RTC backup across the reset (0 none).
 */

CAN_MSG(PitDiag_health, 0x704, 8, "VCU", 1000)
    FIELD_BE (free_heap,     uint16_t, 0, 16, 1, 0, "B")
    FIELD_BE (min_free_heap, uint16_t, 2, 16, 1, 0, "B")
    FIELD_LE (task_ran_mask, uint8_t,  4, 8,  1, 0, "bitmask")
    FIELD_LE (reset_cause,   uint8_t,  5, 8,  1, 0, "enum")
    FIELD_LE (uptime_s,      uint8_t,  6, 8,  1, 0, "s")
    FIELD_LE (last_fault,    uint8_t,  7, 8,  1, 0, "code")
CAN_MSG_END(PitDiag_health)
