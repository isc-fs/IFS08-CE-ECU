/*
 * 0x702  PitDiag_inverter -- inverter DC-bus voltage, motor RPM (SIGNED), and
 * the inverter error code. Mirrors PitDiag_BuildInverter(). 100 ms while
 * enabled. inv_rpm is a 32-bit big-endian SIGNED value (FIELD_BE_S).
 */

CAN_MSG(PitDiag_inverter, 0x702, 7, "VCU", 100)
    FIELD_BE   (dc_bus_voltage, uint16_t, 0, 16, 1, 0, "V")
    FIELD_BE_S (inv_rpm,        int32_t,  2, 32, 1, 0, "rpm")
    FIELD_LE   (inv_error,      uint8_t,  6, 8,  1, 0, "code")
CAN_MSG_END(PitDiag_inverter)
