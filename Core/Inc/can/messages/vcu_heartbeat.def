/*
 * 0x100  VCU_heartbeat -- the DC-bus voltage the ECU streams to the ACU bus
 * every control cycle. The AMS arms a VcuStale watchdog on this frame in Car
 * mode and opens the AIRs if it stops (see IFS08-CE-ECU#<heartbeat issue>),
 * so its presence and layout are a load-bearing ECU<->AMS contract -- which
 * is exactly why it is declared here ONCE and the encoder + DBC derive from
 * it. Mirrors the hand-rolled build_acu_dc_bus_frame() it replaced.
 *
 * Standard 11-bit ID, dlc 2, dc_bus_voltage as little-endian uint16 (V).
 *
 * Field macro args: (name, ctype, byte_idx, bit_len, factor, offset, unit)
 */

CAN_MSG(VCU_heartbeat, 0x100, 2, "VCU", 10)
    FIELD_LE (dc_bus_voltage, uint16_t, 0, 16, 1, 0, "V")
CAN_MSG_END(VCU_heartbeat)
