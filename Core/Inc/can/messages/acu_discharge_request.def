/*
 * 0x021  ACU_discharge_request -- RX from the AMS. "The DC link is stranded;
 * please hold the bleed connected until it is drained." (#198)
 *
 * The AMS asserts on:
 *     FSM in Start  AND  TSMS on  AND  dc_bus_V > 60 V
 *
 * The Start qualifier is what makes this safe. TSMS-on with a charged link is
 * ALSO true during normal driving, so without it this would command a bleed
 * across a live tractive system at speed. In Start the AIRs are open, so the
 * same reading uniquely means "the shutdown circuit was cycled and the
 * discharge did not finish". The AMS knows FSM state, TSMS and AIR state; the
 * ECU knows none of them, which is why the request comes from that side.
 *
 * A LEVEL, not an edge. A stranded link keeps this true for as long as it is
 * stranded, so neither side has to catch a fast SDC transient.
 *
 * LOSING THIS FRAME DOES NOT ABORT A DISCHARGE. The ECU latches on receipt and
 * releases on its OWN voltage measurement, so a single dropout mid-discharge
 * cannot re-strand the link. Freshness only gates whether a NEW discharge may
 * be started.
 *
 * ID chosen next to 0x020 ACU_ok_precharge: same sender, same safety class, and
 * a low ID so it wins arbitration against the diagnostic traffic on this bus.
 */

CAN_MSG(ACU_discharge_request, 0x021, 1, "AMS", 100)
    FIELD_LE_BITS (request, uint8_t, 0, 1, 1, 0, "bit")
CAN_MSG_END(ACU_discharge_request)
